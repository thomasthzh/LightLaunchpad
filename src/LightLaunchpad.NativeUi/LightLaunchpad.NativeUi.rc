#include "LightLaunchpad.BuildIdentity.generated.h"
#include "LightLaunchpad.Version.h"
#include <winver.h>

IDI_APP ICON "../LightLaunchpad.App/Assets/LightLaunchpad.ico"

1 24 "LightLaunchpad.NativeUi.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LLP_FILE_VERSION_COMMA
 PRODUCTVERSION LLP_FILE_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LightLaunchpad\0"
            VALUE "FileDescription", "LightLaunchpad Native UI\0"
            VALUE "FileVersion", LLP_FILE_VERSION_STRING "\0"
            VALUE "InternalName", "LightLaunchpad.NativeUi\0"
            VALUE "OriginalFilename", "LightLaunchpad.NativeUi.exe\0"
            VALUE "ProductName", "LightLaunchpad\0"
            VALUE "ProductVersion", LLP_BUILD_VERSION_STRING "\0"
            VALUE "BuildCommit", LLP_BUILD_COMMIT_STRING "\0"
            VALUE "BuildChannel", LLP_BUILD_CHANNEL_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
