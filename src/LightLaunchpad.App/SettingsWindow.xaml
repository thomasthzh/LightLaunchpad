<Window x:Class="LightLaunchpad.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightLaunchpad Settings"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="FolderLabel" Text="Launchpad folder" VerticalAlignment="Center" />
        <TextBox x:Name="FolderTextBox" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock x:Name="HotkeyLabel" Grid.Row="1" Text="Hotkey" VerticalAlignment="Center" />
        <TextBox x:Name="HotkeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock x:Name="IconSizeLabel" Grid.Row="2" Text="Icon size" VerticalAlignment="Center" />
        <ComboBox x:Name="IconSizeComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <ComboBoxItem Content="Small" />
            <ComboBoxItem Content="Medium" />
            <ComboBoxItem Content="Large" />
        </ComboBox>

        <TextBlock x:Name="DisplayModeLabel" Grid.Row="3" Text="Open mode" VerticalAlignment="Center" />
        <ComboBox x:Name="DisplayModeComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <ComboBoxItem Tag="Launchpad" Content="启动台" />
            <ComboBoxItem Tag="Spotlight" Content="聚焦" />
        </ComboBox>

        <TextBlock x:Name="LanguageLabel" Grid.Row="4" Text="Language" VerticalAlignment="Center" />
        <ComboBox x:Name="LanguageComboBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Margin="0,0,0,10"
                  SelectionChanged="LanguageComboBox_SelectionChanged">
            <ComboBoxItem Tag="English" Content="English" />
            <ComboBoxItem Tag="Chinese" Content="中文" />
        </ComboBox>

        <TextBlock x:Name="SpotlightSizeLabel" Grid.Row="5" Text="Spotlight size" VerticalAlignment="Center" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SpotlightWidthTextBox" Width="92" />
            <TextBlock x:Name="SpotlightSizeSeparator" Text=" x " VerticalAlignment="Center" Margin="8,0" />
            <TextBox x:Name="SpotlightHeightTextBox" Width="92" />
        </StackPanel>

        <TextBlock x:Name="AppSpacingLabel" Grid.Row="6" Text="App spacing" VerticalAlignment="Center" />
        <TextBox x:Name="AppSpacingTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" />

        <TextBlock x:Name="WheelSensitivityLabel" Grid.Row="7" Text="Wheel sensitivity" VerticalAlignment="Center" />
        <TextBox x:Name="WheelSensitivityTextBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" />

        <CheckBox x:Name="StartWithWindowsCheckBox"
                  Grid.Row="8"
                  Grid.Column="1"
                  Content="Start with Windows"
                  Margin="0,0,0,10" />

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="86" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" Width="86" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>