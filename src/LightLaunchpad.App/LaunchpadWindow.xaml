<Window x:Class="LightLaunchpad.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:LightLaunchpad.App.ViewModels"
        Title="LightLaunchpad"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Grid Background="#CC10151E"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="WindowScale" ScaleX="0.98" ScaleY="0.98" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,44,0,28"
                HorizontalAlignment="Center"
                Width="560"
                MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Background="#F3F7FAFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20,10">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#151A22"
                     CaretBrush="#151A22"
                     FontSize="22"
                     FontWeight="SemiBold"
                     VerticalContentAlignment="Center"
                     SelectionBrush="#557EB6FF" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="48,0,48,52">
            <ItemsControl ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:LaunchItemViewModel}">
                        <Button Width="{Binding TileSize}"
                                Height="{Binding TileSize}"
                                Margin="8"
                                Click="LaunchItem_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource LaunchpadTextBrush}"
                                Cursor="Hand"
                                ToolTip="{Binding DisplayName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Tile"
                                            CornerRadius="8"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="#24FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="#30FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Center">
                                <Image Source="{Binding Icon}"
                                       Width="{Binding IconSize}"
                                       Height="{Binding IconSize}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding DisplayName}"
                                           Margin="0,10,0,0"
                                           Width="{Binding LabelWidth}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource LaunchpadTextBrush}"
                                           FontSize="13"
                                           LineHeight="16"
                                           MaxHeight="34" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
