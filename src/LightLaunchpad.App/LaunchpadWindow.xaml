<Window x:Class="LightLaunchpad.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:LightLaunchpad.App.ViewModels"
        Title="LightLaunchpad"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="Assets/Alice.gif"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <DataTemplate x:Key="AppTileTemplate" DataType="{x:Type viewModels:LaunchItemViewModel}">
            <Button Width="{Binding TileSize}"
                    Height="{Binding TileSize}"
                    Margin="8"
                    Click="LaunchItem_Click"
                    PreviewMouseMove="LaunchItem_PreviewMouseMove"
                    Drop="LaunchItem_Drop"
                    AllowDrop="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource LaunchpadTextBrush}"
                    Cursor="Hand"
                    ToolTip="{Binding DisplayName}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Launch" Click="LaunchMenuItem_Click"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Rename" Click="RenameItem_Click"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Remove from launchpad" Click="RemoveItem_Click"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Open file location" Click="OpenItemLocation_Click"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="{Binding Icon}"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}"
                               Margin="0,10,0,0"
                               Width="{Binding LabelWidth}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource LaunchpadTextBrush}"
                               FontSize="13"
                               LineHeight="16"
                               MaxHeight="34" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="#CC10151E"
          RenderTransformOrigin="0.5,0.5">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Create region" Click="CreateRegion_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate" Y="10" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,22,26,0"
                Width="36"
                Height="36"
                Content="⚙"
                FontSize="18"
                Foreground="#F7FAFF"
                Background="#22FFFFFF"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Click="GearButton_Click">
            <Button.ContextMenu>
                <ContextMenu x:Name="GearMenu">
                    <MenuItem Header="Inline regions" Click="SetInlineRegions_Click" />
                    <MenuItem Header="Region tabs" Click="SetRegionTabs_Click" />
                    <Separator />
                    <MenuItem Header="Import Start Menu apps" Click="ImportStartMenu_Click" />
                    <MenuItem Header="Import .vui files" Click="ImportVui_Click" />
                    <Separator />
                    <MenuItem Header="Settings" Click="OpenSettings_Click" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <Border Grid.Row="0"
                Margin="0,44,0,18"
                HorizontalAlignment="Center"
                Width="560"
                MaxWidth="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ActualWidth}"
                Background="#F3F7FAFF"
                BorderBrush="#55FFFFFF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="20,10">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#151A22"
                     CaretBrush="#151A22"
                     FontSize="22"
                     FontWeight="SemiBold"
                     VerticalContentAlignment="Center"
                     SelectionBrush="#557EB6FF" />
        </Border>

        <ItemsControl Grid.Row="1"
                      Margin="48,0,48,16"
                      Visibility="{Binding RegionTabsVisibility}"
                      ItemsSource="{Binding Regions}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:LaunchpadRegionViewModel}">
                    <Button Content="{Binding Name}"
                            Tag="{Binding Id}"
                            Margin="5,0"
                            Padding="14,7"
                            Click="RegionTab_Click"
                            Drop="Region_Drop"
                            AllowDrop="True"
                            Background="#24FFFFFF"
                            Foreground="#F7FAFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename region" Click="RenameRegion_Click"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Delete region" Click="DeleteRegion_Click"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="48,0,48,52">
            <Grid>
                <ItemsControl Visibility="{Binding InlineRegionsVisibility}"
                              ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:LaunchpadRegionViewModel}">
                            <StackPanel Margin="0,0,0,22"
                                        Tag="{Binding Id}"
                                        Drop="Region_Drop"
                                        AllowDrop="True">
                                <TextBlock Text="{Binding Name}"
                                           Margin="12,0,12,10"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#DDE7F7">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename region" Click="RenameRegion_Click"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Delete region" Click="DeleteRegion_Click"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Items}"
                                              ItemTemplate="{StaticResource AppTileTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl Visibility="{Binding RegionTabsVisibility}"
                              ItemsSource="{Binding ActiveRegionItems}"
                              ItemTemplate="{StaticResource AppTileTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
